# --- Gemini (AI Studio API key — simplest path) ---
GOOGLE_API_KEY=

# Vertex AI path (alternative, e.g. for hackathon GCP credits):
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
# GOOGLE_CLOUD_LOCATION=us-central1

# Models
GEMINI_MODEL=gemini-3.1-pro-preview
JUDGE_MODEL=gemini-3.5-flash

# --- Phoenix Cloud ---
# API key at app.phoenix.arize.com → Settings → API Keys (format px_live_...)
PHOENIX_API_KEY=
# REQUIRED: the space Hostname from Phoenix → Settings (must include /s/<space>).
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-space>
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/<your-space>
PHOENIX_PROJECT_NAME=earned-autonomy

# --- App ---
# APP_DB_PATH=app.db
